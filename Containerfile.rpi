# AlmaLinux 10 image-mode (bootc) base for Raspberry Pi (aarch64).
#
# This is the Pi sibling of ./Containerfile. It derives FROM AlmaLinux's
# experimental Raspberry Pi bootc base, which already bakes in the Pi firmware,
# a Pi-specific kernel (rebased on Raspberry Pi OS sources), device-tree
# management and the rpi-bootc-bootloader sync tool. Because of that, there is
# NO firmware/UEFI decision to make here — the Pi boots natively.
#
#   Base:  quay.io/almalinuxorg/almalinux-bootc-rpi:10   (arm64 ONLY)
#   Tested by AlmaLinux on: Pi 5 (2/8/16G), Pi 4, Pi 3, Pi Zero 2 W.
#   Upstream: https://github.com/AlmaLinux/bootc-images-rpi  (marked EXPERIMENTAL)
#
# MUST build for arm64:  podman build --platform linux/arm64 -f Containerfile.rpi .
# On the x86 builder this means qemu emulation (slow); a native aarch64 host is
# better. Build-host decision is still open.
#
# The aarch64 Katello content this image installs from ALREADY EXISTS in Foreman
# (built out separately): product 'AlmaLinux 10 aarch64' (label AlmaLinux_10_aarch64),
# content view 'AlmaLinux 10 aarch64' (id 21) @ Production, and activation key
# 'AlmaLinux 10 aarch64' (id 11) bound to that CV. Arch separation is by content
# view — the key resolves to an aarch64-only CV — so the enablerepo glob below is
# the same one the x86 ./Containerfile uses. See RPI-KATELLO.md for the inventory.
FROM quay.io/almalinuxorg/almalinux-bootc-rpi:10

# --- Metadata --------------------------------------------------------------
LABEL org.opencontainers.image.title="almalinux10-bootc-rpi" \
      org.opencontainers.image.description="AlmaLinux 10 image-mode base for Garaventaville Raspberry Pi fleet" \
      org.opencontainers.image.vendor="garaventaville"

# --- Packages from Katello (aarch64) --------------------------- KATELLO ---
# Mirrors ./Containerfile's package set, with two Pi differences:
#   * drops qemu-guest-agent (no hypervisor on bare-metal Pi)
#   * adds cloud-init + cloud-utils-growpart so first boot grows the root fs and
#     applies NoCloud user-data from the CIDATA partition (this replaces
#     AlmaLinux's separate "bootstrap-image" layer — we bake it in directly).
# Every other package is available aarch64 from the 'AlmaLinux 10 aarch64' CV's
# repos: duo_unix comes from the aarch64 EPEL repo (not Duo's own repo, which has
# no aarch64), and katello-host-tools[-tracer] are noarch from the Foreman Client
# repo. The enablerepo glob matches the x86 ./Containerfile — the aarch64 key's CV
# scopes it to aarch64 content.
RUN dnf -y install subscription-manager \
 && rpm -Uvh --replacepkgs http://foreman.garaventaville.com/pub/katello-ca-consumer-latest.noarch.rpm \
 && subscription-manager register --org Garaventaville --activationkey 'AlmaLinux 10 aarch64' \
 && dnf -y --disablerepo='*' --enablerepo='Garaventaville_AlmaLinux_10_*' upgrade \
 && dnf -y --disablerepo='*' --enablerepo='Garaventaville_AlmaLinux_10_*' --enablerepo='Garaventaville_Zabbix_*' install \
        cloud-init \
        cloud-utils-growpart \
        ipa-client \
        autofs \
        rsync \
        shadow-utils \
        zsh \
        perl \
        git \
        git-credential-oauth \
        vim-enhanced \
        tmux \
        bash-completion \
        yum-utils \
        htop \
        btop \
        atop \
        nmon \
        ocl-icd \
        duo_unix \
        i2c-tools \
        katello-host-tools \
        katello-host-tools-tracer \
        proxmox-backup-client \
        zabbix-agent2 \
        openbao \
 && { subscription-manager unregister || true; } \
 && { subscription-manager clean || true; } \
 && rm -f /etc/yum.repos.d/almalinux*.repo \
 && dnf clean all \
 && rm -rf /var/cache/dnf /var/lib/dnf/history.sqlite* /var/log/dnf* /var/log/hawkey.log
# ------------------------------------------------------------- /KATELLO ---

# First-boot root growth on an ostree root needs two tweaks (both from AlmaLinux's
# rpi bootstrap layer):
#   1. growpart grows the partition behind /sysroot (the physical root) — config.
#   2. cloud-init's cc_resizefs defaults to resizing the fs at "/", which is the
#      read-only ostree deployment; repoint it at /var (same root xfs, writable).
COPY image/rpi/10-bootc-growpart.cfg /etc/cloud/cloud.cfg.d/
RUN sed -i 's@resize_what = "/"@resize_what = "/var"@' \
        /usr/lib/python*/site-packages/cloudinit/config/cc_resizefs.py \
 && rm -f /usr/lib/python*/site-packages/cloudinit/config/__pycache__/cc_resizefs*.pyc

# --- Raspberry Pi firmware config (config.txt) ------------------------------
# config.txt on the FAT firmware partition is AUTO-GENERATED by rpi-bootc-bootloader
# ("Do not edit") and `include`s, per boot entry, the image-supplied rpi-config.txt
# at /usr/lib/modules/<kver>/rpi-config.txt — the upstream-intended, image-versioned
# customization hook (survives A/B updates + rollback; each ostree entry carries its
# own). The bootloader copies it to /boot/efi/bootc/entries/ostree-N/rpi-config.txt,
# so these options land in the active config the Pi firmware reads. Enables the i2c
# bus + a DS3231 RTC overlay (i2c-tools is installed above) and serial console.
# Written into every installed kernel's modules dir (matches the bootloader's lookup).
COPY image/rpi/rpi-config.txt /usr/share/garaventaville/rpi-config.txt
RUN set -e; for d in /usr/lib/modules/*/; do \
        install -m0644 /usr/share/garaventaville/rpi-config.txt "${d}rpi-config.txt"; \
    done

# --- Services --------------------------------------------------------------
# No qemu-guest-agent on a Pi. cloud-init is enabled by its RPM presets.
RUN systemctl enable sshd

# Zabbix agent2: Server/ServerActive point at the fleet's zabbix.garaventaville.com
# (not host-specific, safe to bake in). Hostname is left at RPM defaults and set
# post-boot, same host-state pattern as the PBS credentials above.
#
# The zabbix-agent2 RPM creates its system user via an old-style %pre
# scriptlet (useradd), which doesn't survive ostree's /etc merge on an
# upgrade of an already-deployed host (see zabbix-agent2-sysusers.conf) --
# drop a declarative sysusers.d fallback so systemd-sysusers (which runs at
# every boot) recreates it if the merge drops it again.
COPY image/rpi/zabbix-agent2-sysusers.conf /usr/lib/sysusers.d/zabbix-agent2.conf
RUN sed -i \
      -e 's/^Server=.*/Server=zabbix.garaventaville.com/' \
      -e 's/^ServerActive=.*/ServerActive=zabbix.garaventaville.com/' \
      /etc/zabbix/zabbix_agent2.conf \
 && systemctl enable zabbix-agent2

# kdump is useless on a Pi (and can't rebuild its initramfs on a read-only
# ostree root); mask it as we do on the x86 image.
RUN systemctl mask kdump.service

# --- Management SSH (root) keys: Foreman rex + Ascender/AWX -----------------
# Arch-independent; reused verbatim from the x86 image. Baked into /usr so they
# survive the bootc first-boot /var init.
COPY image/foreman-rex.root.keys /usr/share/foreman-rex/root.keys
COPY image/sshd-foreman-rex.conf /etc/ssh/sshd_config.d/10-foreman-rex.conf

# --- bootc -> Katello image-mode facts -------------------------------------
# Reused verbatim. Requires subscription-manager (installed in the Katello block
# above); if that block is commented out for a derive-only smoke test, also
# drop the timer enable below.
COPY image/bootc-rhsm-facts /usr/libexec/bootc-rhsm-facts
COPY image/bootc-rhsm-facts.service /usr/lib/systemd/system/bootc-rhsm-facts.service
COPY image/bootc-rhsm-facts.timer /usr/lib/systemd/system/bootc-rhsm-facts.timer
RUN chmod 0644 /usr/share/foreman-rex/root.keys /etc/ssh/sshd_config.d/10-foreman-rex.conf \
 && chmod 0755 /usr/libexec/bootc-rhsm-facts \
 && systemctl enable bootc-rhsm-facts.timer

# --- Nightly Proxmox Backup Server host backup ------------------------------
# Same units as dns-00/dns-01 (this base OS's own /Containerfile doesn't run
# this backup, only the Pi does): auth via the backup@pbs!pve API token (plain
# password auth on backup@pbs hits a TFA wall on this realm), decryption key at
# /root/backup.key. Both the systemd-encrypted credentials
# (proxmox-backup-client.password / .encryption-password) and /root/backup.key
# are host state, not image content — placed by hand per host after first boot,
# same as the rex/Ascender keys above. Enable only the timer; the service stays
# disabled and is TriggeredBy=proxmox-backup-client.timer.
#
# Unlike dns-00/dns-01 (single-filesystem RPM hosts), a bootc/ostree root splits
# /etc and /var onto separate mounts from "/" — a plain `root.pxar:/` backup
# skips them as other mount points, so it would miss cthun's actual monitoring
# stack data (Grafana DB, Prometheus TSDB, container storage) under
# /var/home/monitoring. The ExecStart below adds a second archive,
# monitoring.pxar:/var/home/monitoring, to cover it explicitly.
COPY image/proxmox-backup-client.service /usr/lib/systemd/system/proxmox-backup-client.service
COPY image/proxmox-backup-client.timer /usr/lib/systemd/system/proxmox-backup-client.timer
RUN systemctl enable proxmox-backup-client.timer

RUN rm -rf /tmp/* /var/tmp/*

# Validate the image is a well-formed bootc target.
RUN bootc container lint

# No CMD/ENTRYPOINT — bootc boots the OS.
