# Authorized keys for root SSH on image-mode hosts. Baked into /usr (immutable)
# because %post-injected /root keys don't survive bootc's first-boot /var init.
# Add a management system's public key here, rebuild, and bootc upgrade.

# Foreman remote execution (Script provider)
ssh-rsa  foreman-proxy@foreman.garaventaville.com

# Ascender / AWX "Global Root" machine credential
ssh-rsa  root@ascender.garaventaville.com
