# kubernetes-controlplane — control plane node image (image-mode / bootc).
#
# Builds FROM the locally-built kubernetes-common image and adds the control
# plane HA packages (keepalived + haproxy). Their configuration is NOT baked: it
# is rendered at runtime by roles/controlplane_infra from per-host Foreman
# parameters (keepalived state/priority, HAProxy backends), so only the packages
# live here.
#
# Build context is the repo root:
#   podman build -t kubernetes-controlplane:1.35.5 \
#     --build-arg K8S_IMAGE_TAG=1.35.5 --pull=false \
#     -f kubernetes/controlplane/Containerfile .
ARG K8S_IMAGE_TAG=1.35.5
FROM kubernetes-common:${K8S_IMAGE_TAG}

LABEL org.opencontainers.image.title="kubernetes-controlplane" \
      org.opencontainers.image.description="Kubernetes control plane node image (keepalived + haproxy) for the Garaventaville fleet" \
      org.opencontainers.image.vendor="garaventaville"

# --disablerepo='*MySQL*': keepalived pulls mariadb-connector-c; with the MySQL
# 8.4 repo enabled dnf would instead pull mysql-community-* and conflict with
# mariadb. Disabling it keeps the client lib coming from BaseOS.
RUN subscription-manager register --org Garaventaville --activationkey 'AlmaLinux 10 Kubernetes' \
 && dnf -y --disablerepo='*' --enablerepo='Garaventaville_AlmaLinux_10_*' --disablerepo='*MySQL*' install \
        keepalived \
        haproxy \
 && { subscription-manager unregister || true; } \
 && { subscription-manager clean || true; } \
 && dnf clean all \
 && rm -rf /var/cache/dnf /var/lib/dnf/history.sqlite* /var/log/dnf* /var/log/hawkey.log

# --- firewalld: control plane ports (default 'public' zone) -----------------
# Adds control-plane ports on top of the all-node set baked in kubernetes-common.
# Previously opened at runtime by roles/controlplane_infra. haproxy_port is the
# fleet-wide constant 7443 (vars/vms.yml).
#   6443/tcp        kube-apiserver       7443/tcp  HAProxy frontend
#   2379-2380/tcp   etcd client/peer     2381/tcp  etcd metrics
RUN firewall-offline-cmd --zone=public \
        --add-port=6443/tcp \
        --add-port=7443/tcp \
        --add-port=2379/tcp \
        --add-port=2380/tcp \
        --add-port=2381/tcp

RUN rm -rf /tmp/* /var/tmp/*
RUN bootc container lint
